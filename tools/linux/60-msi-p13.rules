# MSI MPG CoreLiquid P13 360 — Artinchip USB display + HID control
# Install: sudo cp 60-msi-p13.rules /etc/udev/rules.d/ && sudo udevadm control --reload
# Must sort before 73-seat-late.rules, which applies the uaccess ACL.

# Artinchip composite device (display + HID)
SUBSYSTEM=="usb", ATTR{idVendor}=="33c3", ATTR{idProduct}=="0e02", MODE="0660", TAG+="uaccess"

# hidraw nodes for interface 1
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="33c3", ATTRS{idProduct}=="0e02", MODE="0660", TAG+="uaccess"
