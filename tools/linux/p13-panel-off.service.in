[Unit]
Description=MSI P13 panel off on display sleep and at logout/shutdown
Documentation=file://@ROOT@/README.md
# Stops after p13-display.service so brightness 0 is the last panel command.
Before=p13-display.service
PartOf=graphical-session.target
# The user manager stops this unit for both logout and machine shutdown. The
# ordering runs the stop job at the start of the exit transaction, while the
# session is still up. sleepwatch additionally holds a logind shutdown delay
# lock and blanks the panel on PrepareForShutdown, so poweroff/reboot waits
# for brightness 0 before tearing anything down.
Before=exit.target shutdown.target
Conflicts=exit.target shutdown.target

[Service]
Type=simple
ExecStart=@P13CTL_BIN@ display sleepwatch
ExecStop=@P13CTL_BIN@ hid brightness 0 --no-save
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
